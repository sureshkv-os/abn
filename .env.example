# Contact form email delivery (Resend) — see src/lib/email.ts
# Without RESEND_API_KEY, enquiries are logged to the server console only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=            # recipient of enquiries (TODO client, Q20)
CONTACT_FROM_EMAIL=          # verified Resend sender, e.g. enquiries@accountantsbrisbanenorth.com.au

# Cloudflare Turnstile spam protection — see src/app/api/contact/route.ts
# Without TURNSTILE_SECRET_KEY, verification is skipped (honeypot still applies).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Analytics (TODO client, Q14) — add GA4 measurement ID and GSC verification
NEXT_PUBLIC_GA_ID=
